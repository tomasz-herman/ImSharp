<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../ImSharpNative/CMake.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <!-- NuGet Package Metadata -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>ImSharp</PackageId>
        <Version Condition="'$(Version)' == ''">1.93.0</Version>
        <Authors>ImSharp Contributors</Authors>
        <Description>Autogenerated, safe C# bindings for Dear ImGui (docking + multi-viewports), ImPlot, ImPlot3D, imnodes, ImNodes (rokups), imgui-node-editor, ImGuizmo, imGuIZMO.quat, and ImGuiColorTextEdit, with GLFW, OpenGL3, OpenGL2, Null, Vulkan, SDL2, SDL3, and Windows backends.</Description>
        <PackageTags>imgui;cimgui;implot;implot3d;imguizmo;imnodes;gui;gamedev;opengl;vulkan;sdl;glfw</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryType>git</RepositoryType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
        <None Include="$(CMakeBuildOutput)"
              Condition="'$(PrebuiltNativeRuntimesDir)' == ''"
              CopyToOutputDirectory="PreserveNewest"
              Link="%(Filename)%(Extension)"
              Pack="true"
              PackagePath="runtimes/$(NativeRid)/native/"
              Visible="false" />
        <None Include="$(PrebuiltNativeRuntimesDir)/**/*"
              Condition="'$(PrebuiltNativeRuntimesDir)' != ''"
              Pack="true"
              PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
              Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../ImSharpGenerator/ImSharpGenerator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>
</Project>
