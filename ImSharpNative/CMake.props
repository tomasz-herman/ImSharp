<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <CMakeSourceDir>$(MSBuildThisFileDirectory)</CMakeSourceDir>
        <CMakeBuildDir>$(CMakeSourceDir)cmake-build</CMakeBuildDir>
        <CMakeExecutable>cmake</CMakeExecutable>
        <BuildConfiguration Condition="'$(BuildConfiguration)' == ''">$(Configuration)</BuildConfiguration>
        <BuildConfiguration Condition="'$(BuildConfiguration)' == ''">Debug</BuildConfiguration>
    </PropertyGroup>

    <PropertyGroup>
        <NativeRid Condition="'$(NativeRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</NativeRid>
        <NativeRid Condition="'$(NativeRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</NativeRid>
        <NativeRid Condition="'$(NativeRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-x64</NativeRid>

        <CMakeBuildOutput Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(CMakeBuildDir)/$(BuildConfiguration)/ImSharpNative.dll</CMakeBuildOutput>
        <CMakeBuildOutput Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(CMakeBuildDir)/libImSharpNative.so</CMakeBuildOutput>
        <CMakeBuildOutput Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(CMakeBuildDir)/libImSharpNative.dylib</CMakeBuildOutput>
    </PropertyGroup>

    <PropertyGroup>
        <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    </PropertyGroup>

    <ItemGroup>
        <NativeCppFiles Include="$(CMakeSourceDir)CMakeLists.txt" />
        <NativeCppFiles Include="$(CMakeSourceDir)*.cpp" />
        <NativeCppFiles Include="$(CMakeSourceDir)*.c" />
        <NativeCppFiles Include="$(CMakeSourceDir)*.h" />
        <NativeCppFiles Include="$(CMakeSourceDir)*.hpp" />
    </ItemGroup>

    <Import Project="$(MSBuildThisFileDirectory)CMake.targets" />
</Project>
